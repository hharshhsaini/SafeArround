# Copy to .env (`make env`) and fill in. Only variables the code or
# docker-compose.yml actually read are listed.

# Server
SERVER_HOST=localhost
SERVER_PORT=8000
# development | production | testing (testing skips the required-config checks)
ENV=development
GIN_MODE=debug
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006

# Database (PostgreSQL + PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_USER=safearound_user
DB_PASSWORD=your_secure_password
DB_NAME=safearound_dev
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Redis: set REDIS_URL (e.g. Upstash) or REDIS_HOST/REDIS_PORT
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Auth (access tokens last 15 minutes, refresh tokens 7 days)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# External APIs
GOOGLE_MAPS_API_KEY=your_google_maps_key
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
# Number SMS alerts are sent from, in E.164 form (e.g. +15551234567)
TWILIO_FROM=
# Firebase service-account key (the whole JSON file, on one line) for FCM HTTP v1.
# Optional: Expo push tokens are delivered through Expo without it.
FCM_SERVICE_ACCOUNT_JSON=

# docker-compose.yml only
APP_VERSION=latest
GRAFANA_PASSWORD=safearound123
